# SwiftPM
.build/
.swiftpm/
Package.resolved

# Build output: the .app bundle, the rendered iconset and the .icns are all
# regenerated by Scripts/make-app.sh
build/

# An app bundle anywhere, not just in build/. A copy left in the working tree
# was picked up by `git add -A` once already. It matters more than the wasted
# space: a bundle built with `make-app.sh --embed` carries the YMCS AccessKey
# in its Info.plist, and this repository is public.
*.app/

# macOS
.DS_Store
